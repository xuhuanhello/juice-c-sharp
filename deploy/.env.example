# 复制成 .env 后填写。**.env 不入库**（见根 .gitignore）。
#
# 决议：https://github.com/xuhuanhello/juice-c-sharp/issues/117

# --- 必填三项 -----------------------------------------------------------

# TURN 的 HMAC 签名密钥。coturn 与信令服务器**共用这一个值**，这是
# 只留一份 .env 的全部理由 —— 抄两遍就会有对不上的那天，而症状是一片
# 莫名的 401/438，不看 secret 能查很久。
# 生成：openssl rand -hex 32
TURN_SECRET=

# 你的域名或公网 IP。要和 turnserver.conf 里的 realm 一致。
TURN_REALM=turn.example.org

# **云主机必填。** 网卡上是私网地址时，不填这条 coturn 会把私网地址当
# relay 候选发出去，对端永远连不上。有弹性公网 IP 就填那个。
TURN_EXTERNAL_IP=

# --- 信令服务器用（实现归 #121）-----------------------------------------
# 客户端拿到的就是这两行的值，经 room-created / joined 的 iceServers 下发。
# 把 turn.example.org 换成你的域名。
TURN_URLS=turn:turn.example.org:3478?transport=udp,turn:turn.example.org:3478?transport=tcp
STUN_URLS=stun:turn.example.org:3478

# 凭据有效期。12 小时 —— 它只需要不可猜，不需要短命（secret 已经不在
# 客户端里了）。开小了会把「host 开着房过夜」变成故障。
TURN_TTL_SECONDS=43200

# --- 信令服务器：端口与 TLS ---------------------------------------------
# 宿主上暴露哪个端口。容器内恒为 8080。
SIGNAL_PORT=8080

# TLS 二选一（README「TLS 放哪」一节有完整说明）：
#
#   ① **容器自己终止 TLS** —— 填下面三项。SIGNAL_TLS_DIR 是宿主上放证书的
#      目录，它会被挂到容器里的 /certs（只读），所以后两项写**容器内**路径。
#      certbot 的话通常是 /etc/letsencrypt/live/<域名>/
#
#   ② **前置反代终止 TLS**（你已经在跑 nginx/Caddy 就走这条）—— 三项全部
#      留空，容器监听明文 ws，由反代对外提供 wss。
#
# 客户端**无论哪条路看到的都是 wss://** —— #116 选 wss 是为了买断 Android
# cleartext 与 iOS ATS 的不确定性，那只要求客户端侧是 wss，不管 TLS 在哪层终止。
SIGNAL_TLS_DIR=
SIGNAL_TLS_CERT=
SIGNAL_TLS_KEY=

# 服务器日志级别：INFO 够用；查转发问题时开 DEBUG（会打出每条被丢弃的转发）。
SIGNAL_LOG_LEVEL=INFO
